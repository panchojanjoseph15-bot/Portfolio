---
interface Props {
  title: string;
}

const { title } = Astro.props;

// TODO: set this to your portfolio's final URL (your *.pages.dev address or custom domain).
// No trailing slash needed. It feeds the canonical link, social-share tags and structured data.
const SITE_URL = "https://your-portfolio.pages.dev";
const siteUrl = SITE_URL.replace(/\/+$/, "");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jan Joseph",
  alternateName: "Jan Joseph",
  url: siteUrl,
  image: `${siteUrl}/og.image.png`,
  sameAs: [
    "https://github.com/panchojanjoseph15-bot",
    "https://www.facebook.com/janjoseph.pancho",
    "https://www.instagram.com/satelles_dei.ks/?hl=en",
  ],
  jobTitle: "Frontend Web Developer",
  description:
    "Frontend Web Developer building clean, high-performance, and responsive websites for modern businesses.",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Jan Joseph - Frontend Web Developer building clean, high-performance, and responsive websites for modern businesses."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="WizVw-LApQ_OS4UylWw4XXCDVGU2HETs5ZniGolUQ5A" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={siteUrl} />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Jan Joseph | Frontend Web Developer"
    />
    <meta
      property="og:description"
      content="Portfolio of Jan Joseph, Frontend Web Developer specializing in clean, fast, and responsive websites."
    />
    <meta
      property="og:image"
      content={`${siteUrl}/og.image.png`}
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Jan Joseph Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
