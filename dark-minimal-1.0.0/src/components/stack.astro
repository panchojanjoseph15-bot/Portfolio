---
---

<section id="stack" class="max-w-5xl mx-auto px-4 py-12 space-y-6 relative z-10">
  <div>
    <span class="text-xs font-mono text-[#a476ff] uppercase tracking-wider block mb-1">Capabilities</span>
    <h2 class="text-3xl font-bold text-white tracking-tight">Technical Arsenal</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Stack Col 1: Full-Stack -->
    <div class="bento-card rounded-3xl p-6 space-y-4">
      <div class="w-10 h-10 rounded-2xl bg-[#a476ff]/10 border border-[#a476ff]/20 flex items-center justify-center text-[#a476ff]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
      </div>
      <div>
        <h3 class="text-base font-semibold text-white">Full-Stack Development</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">End-to-end architectures, database schemas, and API design.</p>
      </div>
      <div class="flex flex-wrap gap-1.5 font-mono text-xs">
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Astro</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">React</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Next.js</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-[#3ecf8e]">Supabase</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">PostgreSQL</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Node.js</span>
      </div>
    </div>

    <!-- Stack Col 2: Frontend & UI -->
    <div class="bento-card rounded-3xl p-6 space-y-4">
      <div class="w-10 h-10 rounded-2xl bg-[#38bdf8]/10 border border-[#38bdf8]/20 flex items-center justify-center text-[#38bdf8]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
      </div>
      <div>
        <h3 class="text-base font-semibold text-white">Frontend & UI Engineering</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">High-fidelity animations, responsive styling, and accessible layouts.</p>
      </div>
      <div class="flex flex-wrap gap-1.5 font-mono text-xs">
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Tailwind CSS</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">TypeScript</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Electron</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">PWA</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">WebGL</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Figma</span>
      </div>
    </div>

    <!-- Stack Col 3: DevOps & Tools -->
    <div class="bento-card rounded-3xl p-6 space-y-4">
      <div class="w-10 h-10 rounded-2xl bg-amber-400/10 border border-amber-400/20 flex items-center justify-center text-amber-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
      </div>
      <div>
        <h3 class="text-base font-semibold text-white">Programming & DevOps</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">Scripting, version control, edge deployments, and search ranking.</p>
      </div>
      <div class="flex flex-wrap gap-1.5 font-mono text-xs">
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Python</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">C++</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Git / GitHub</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Cloudflare Pages</span>
        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300">Technical SEO</span>
      </div>
    </div>
  </div>
</section>
