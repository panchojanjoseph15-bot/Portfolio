---
import LikeButton from "../React/LikeButton.tsx";
---

<section class="max-w-5xl mx-auto px-4 pt-28 pb-12 relative z-10" id="about">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-5">

    <!-- Main Profile & Hero Card (Span 8) -->
    <div class="bento-card md:col-span-8 rounded-3xl p-7 md:p-9 flex flex-col justify-between overflow-hidden">
      <div class="space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#181a24] border border-white/10 text-xs text-slate-300">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>Full-Stack Web Developer</span>
            <span class="text-white/20">•</span>
            <span class="text-slate-400">Muntinlupa, Philippines</span>
          </div>

          <!-- Live Clock Widget -->
          <div class="font-mono text-xs text-slate-400 bg-white/5 px-2.5 py-1 rounded-full border border-white/5 flex items-center gap-1.5">
            <svg class="w-3 h-3 text-[#a476ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span id="live-time">19:30:00 UTC+8</span>
          </div>
        </div>

        <div class="space-y-3">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Designing clean code.<br />
            <span class="shiny-gradient">Engineering fluid apps.</span>
          </h1>
          <p class="text-sm md:text-base text-slate-400 max-w-xl leading-relaxed">
            I'm <strong class="text-white font-medium">Jan Joseph Reyes</strong>. I build high-performance web applications, responsive client solutions, and desktop apps with modern full-stack architectures.
          </p>
        </div>
      </div>

      <!-- Hero Action Buttons & Socials -->
      <div class="pt-8 flex flex-wrap items-center gap-3 border-t border-white/10 mt-8">
        <a href="#projects" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#a476ff] text-black font-semibold text-xs hover:opacity-90 hover:scale-[1.02] transition-all shadow-lg shadow-[#a476ff]/25">
          <span>Explore Projects</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </a>

        <a href="https://github.com/panchojanjoseph15-bot" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white font-medium text-xs hover:scale-[1.02] transition-all">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/></svg>
          <span>GitHub</span>
        </a>

        <a href="mailto:panchojanjoseph15@gmail.com" class="inline-flex items-center gap-2 px-3 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white transition-all text-xs" title="Send Email">
          <svg class="w-4 h-4 text-[#a476ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="hidden sm:inline">panchojanjoseph15@gmail.com</span>
        </a>
      </div>
    </div>

    <!-- Supabase Interactive Likes Widget (Span 4) -->
    <div class="bento-card md:col-span-4 rounded-3xl p-6 flex flex-col justify-between relative overflow-hidden group">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-[#3ecf8e]/10 border border-[#3ecf8e]/20 flex items-center justify-center text-[#3ecf8e]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M21.362 9.354H12V.396a.396.396 0 0 0-.716-.233L2.203 12.424a.395.395 0 0 0 .32.63h9.476v9.558a.396.396 0 0 0 .716.233l9.081-12.261a.395.395 0 0 0-.434-.23z"/></svg>
            </span>
            <span class="text-xs font-mono font-medium text-[#3ecf8e]">Supabase Live Sync</span>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-slate-400 border border-white/5">PostgreSQL RPC</span>
        </div>

        <h3 class="text-base font-semibold text-white mb-1">Community Appreciation</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          Real-time atomicity with stored procedures. Leave a live like on this portfolio!
        </p>
      </div>

      <!-- Supabase Like Button React Component -->
      <LikeButton 
        client:load 
        supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL}
        supabaseAnonKey={import.meta.env.PUBLIC_SUPABASE_ANON_KEY}
      />

      <div class="text-[11px] text-slate-400 flex items-center justify-between pt-3 border-t border-white/5 font-mono">
        <span>Row ID: portfolio_likes</span>
        <span class="text-emerald-400 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Connected
        </span>
      </div>
    </div>

    <!-- Spotify Music Vibe Pill (Span 4) -->
    <div class="bento-card md:col-span-4 rounded-3xl p-6 flex flex-col justify-between overflow-hidden">
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#1db954]/10 text-[#1db954] flex items-center justify-center">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
            </span>
            <span class="text-xs font-mono font-medium text-slate-300">Spotify Session</span>
          </div>
          <!-- Equalizer animation -->
          <div class="flex items-end gap-1 h-5 px-2 py-0.5 rounded-full bg-white/5">
            <div class="eq-bar"></div>
            <div class="eq-bar"></div>
            <div class="eq-bar"></div>
            <div class="eq-bar"></div>
          </div>
        </div>
        <p class="text-xs text-slate-400">Curated coding playlist & ambient deep focus beats.</p>
      </div>

      <div class="mt-4 p-3 rounded-2xl bg-black/40 border border-white/5 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-800 to-indigo-600 flex items-center justify-center text-white shrink-0 shadow-md">
          🎧
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold text-white truncate">Deep Coding Radio</p>
          <p class="text-[11px] text-slate-400 truncate">Synthesized & Lo-Fi focus</p>
        </div>
        <a 
          href="https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-[11px] font-mono text-[#a476ff] hover:underline shrink-0"
        >
          Play ↗
        </a>
      </div>
    </div>

    <!-- Engineering Performance Card (Span 4) -->
    <div class="bento-card md:col-span-4 rounded-3xl p-6 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-mono text-slate-400">Lighthouse Audit</span>
          <span class="text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20">100 / 100</span>
        </div>
        <h4 class="text-base font-semibold text-white mb-2">Zero Bloat Architecture</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Shipped on Astro & Cloudflare Pages edge. Sub-millisecond initial response with optimized critical render paths.
        </p>
      </div>

      <div class="grid grid-cols-3 gap-2 pt-4 border-t border-white/5 text-center font-mono">
        <div class="p-2 rounded-xl bg-white/5">
          <span class="text-[10px] text-slate-400 block">Performance</span>
          <span class="text-xs font-bold text-emerald-400">100%</span>
        </div>
        <div class="p-2 rounded-xl bg-white/5">
          <span class="text-[10px] text-slate-400 block">SEO & Tags</span>
          <span class="text-xs font-bold text-emerald-400">100%</span>
        </div>
        <div class="p-2 rounded-xl bg-white/5">
          <span class="text-[10px] text-slate-400 block">Best Practices</span>
          <span class="text-xs font-bold text-emerald-400">100%</span>
        </div>
      </div>
    </div>

    <!-- Quick Bio & Specialization (Span 4) -->
    <div class="bento-card md:col-span-4 rounded-3xl p-6 flex flex-col justify-between">
      <div>
        <span class="text-xs font-mono text-[#38bdf8] block mb-2">Philosophy</span>
        <h4 class="text-base font-semibold text-white mb-2">Form Follows Function</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          I believe good websites shouldn't just look pretty on Dribbble—they must convert visitors, load instantly on mobile, and solve actual commercial business goals.
        </p>
      </div>

      <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs text-slate-400">
        <span>Client Satisfaction</span>
        <span class="text-white font-medium flex items-center gap-1">
          <span class="text-amber-400">★★★★★</span> 5.0
        </span>
      </div>
    </div>

  </div>
</section>

<style>
  /* Equalizer animation for Spotify widget */
  @keyframes bar-bounce {
    0%, 100% { height: 4px; }
    50% { height: 18px; }
  }

  .eq-bar {
    width: 3px;
    background: #a476ff;
    border-radius: 9999px;
    animation: bar-bounce 1.2s ease-in-out infinite;
  }

  .eq-bar:nth-child(2) { animation-delay: 0.2s; height: 12px; }
  .eq-bar:nth-child(3) { animation-delay: 0.4s; height: 16px; }
  .eq-bar:nth-child(4) { animation-delay: 0.1s; height: 8px; }
</style>

<script is:inline>
  // Live Manila Time (UTC+8)
  function updateClock() {
    const options = {
      timeZone: 'Asia/Manila',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };
    try {
      const timeStr = new Intl.DateTimeFormat('en-GB', options).format(new Date());
      const el = document.getElementById('live-time');
      if (el) el.textContent = `${timeStr} UTC+8`;
    } catch (e) {
      /* ignore */
    }
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>
