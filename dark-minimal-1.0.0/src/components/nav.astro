---
---

<header class="fixed top-4 left-0 right-0 z-50 px-4 max-w-5xl mx-auto">
  <nav class="bento-card rounded-2xl px-5 py-3 flex items-center justify-between shadow-2xl bg-[#0e1017cc] backdrop-blur-xl border border-white/10">
    <div class="flex items-center gap-3">
      <a href="#hero" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-[#a476ff] to-[#6366f1] flex items-center justify-center font-bold text-white text-sm shadow-md shadow-[#a476ff]/30 group-hover:scale-105 transition-transform">
          JR
        </div>
        <span class="font-semibold text-sm tracking-tight text-white group-hover:text-[#a476ff] transition-colors hidden sm:inline">
          Jan Joseph Reyes
        </span>
      </a>
      <div class="h-4 w-px bg-white/10 hidden sm:block"></div>
      <span class="text-xs text-emerald-400 font-mono hidden md:flex items-center gap-1.5 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Available for hire
      </span>
    </div>

    <!-- Center navigation links -->
    <div class="hidden sm:flex items-center gap-1 bg-white/5 p-1 rounded-xl border border-white/5 text-xs font-medium">
      <a href="#about" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition-all">About</a>
      <a href="#projects" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition-all">Projects</a>
      <a href="#stack" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition-all">Stack</a>
      <a href="#contact" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition-all">Contact</a>
    </div>

    <!-- Right Action Hub -->
    <div class="flex items-center gap-2">
      <button 
        type="button" 
        onclick="window.toggleCmdK()"
        class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs text-slate-400 hover:text-white transition-all font-mono cursor-pointer"
        title="Quick Launcher (Press Cmd+K / Ctrl+K)"
      >
        <svg class="w-3.5 h-3.5 text-[#a476ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <span class="hidden md:inline">Search</span>
        <kbd class="px-1.5 py-0.5 text-[10px] bg-white/10 rounded border border-white/10 text-slate-300 font-mono">⌘K</kbd>
      </button>

      <a 
        href="#contact" 
        class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-[#a476ff] to-[#8b5cf6] hover:opacity-95 text-black font-semibold text-xs transition-all shadow-md shadow-[#a476ff]/20 hover:scale-105"
      >
        Let's Talk
      </a>
    </div>
  </nav>
</header>
