---
interface Project {
  title: string;
  category: "fullstack" | "client";
  badge: string;
  badgeType: "flagship" | "client" | "ecosystem" | "cta";
  subBadge?: string;
  description: string;
  tags: string[];
  demoUrl?: string;
  demoLabel?: string;
  githubUrl?: string;
  isCta?: boolean;
}

const projects: Project[] = [
  {
    title: "Straight to the Top",
    category: "fullstack",
    badge: "★ Flagship App",
    badgeType: "flagship",
    subBadge: "Cross-Platform (.exe & Web)",
    description:
      "GitHub-inspired habit tracking platform & daily reflection journal. Engineered with custom 4-state visual commit graphs, daily retrospectives, tomorrow presets, and desktop packaging.",
    tags: ["React", "TypeScript", "Tailwind CSS", "Electron", "PWA"],
    demoUrl: "https://straight-to-the-top.pages.dev/",
    demoLabel: "Live Demo ↗",
    githubUrl: "https://github.com/panchojanjoseph15-bot/Straight-to-the-top",
  },
  {
    title: "Positive Gym Putatan",
    category: "client",
    badge: "Client Production",
    badgeType: "client",
    subBadge: "Local SEO Optimized",
    description:
      "Modern, responsive web platform built for a commercial fitness establishment in Muntinlupa. Includes dynamic membership pricing tiers, trainer schedules, and tailored local search rank optimization.",
    tags: ["Next.js 14", "React", "Tailwind CSS", "Local SEO"],
    demoUrl: "https://positive-gym-putatan.pages.dev/",
    demoLabel: "Visit Website ↗",
    githubUrl: "https://github.com/panchojanjoseph15-bot/positive-gym-putatan",
  },
  {
    title: "Developer Portfolio & Hub",
    category: "fullstack",
    badge: "Active Ecosystem",
    badgeType: "ecosystem",
    subBadge: "Cloudflare Edge",
    description:
      "Personal portfolio engine featuring WebGL canvas glitch shaders, real-time Supabase RPC synchronization, and edge cloud caching.",
    tags: ["Astro", "React", "Supabase", "Tailwind CSS"],
    demoUrl: "https://portfolio-cqt.pages.dev/",
    demoLabel: "Live Site ↗",
    githubUrl: "https://github.com/panchojanjoseph15-bot/Portfolio",
  },
  {
    title: "Have a project in mind?",
    category: "client",
    badge: "Accepting Contracts",
    badgeType: "cta",
    description:
      "Whether you need a high-converting web application, client website, or complete full-stack MVP, let's bring it to reality with clean architecture and blazing speed.",
    tags: ["Full-Stack", "Frontend", "UI/UX", "API Integration"],
    isCta: true,
  },
];
---

<section id="projects" class="max-w-5xl mx-auto px-4 py-12 space-y-8 relative z-10">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span class="text-xs font-mono text-[#a476ff] uppercase tracking-wider block mb-1">Selected Work</span>
      <h2 class="text-3xl font-bold text-white tracking-tight">Production Showcases</h2>
    </div>

    <!-- Filter Tabs -->
    <div class="flex items-center gap-1.5 p-1 bg-white/5 rounded-2xl border border-white/5 text-xs font-medium self-start sm:self-auto" id="project-filter-group">
      <button type="button" class="filter-btn active px-3 py-1.5 rounded-xl bg-[#a476ff] text-black font-semibold transition-all cursor-pointer" data-filter="all">All (4)</button>
      <button type="button" class="filter-btn px-3 py-1.5 rounded-xl text-slate-400 hover:text-white transition-all cursor-pointer" data-filter="fullstack">Full-Stack</button>
      <button type="button" class="filter-btn px-3 py-1.5 rounded-xl text-slate-400 hover:text-white transition-all cursor-pointer" data-filter="client">Client Work</button>
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
    {
      projects.map((project) => (
        <div class="project-item bento-card rounded-3xl overflow-hidden group flex flex-col justify-between" data-category={project.category}>
          {project.isCta ? (
            <div class="p-7 sm:p-8 flex flex-col justify-between h-full bg-gradient-to-br from-[#1c182c] via-[#141520] to-[#0c0d14] border-purple-500/30">
              <div>
                <div class="flex items-center justify-between mb-6">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                    <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    {project.badge}
                  </span>
                  <div class="w-10 h-10 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-[#a476ff]">
                    🚀
                  </div>
                </div>

                <h3 class="text-2xl font-bold text-white mb-2">{project.title}</h3>
                <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                  {project.description}
                </p>

                <div class="grid grid-cols-2 gap-2 mt-6 font-mono text-xs text-slate-300">
                  <div class="p-2.5 rounded-xl bg-white/5 border border-white/5 flex items-center gap-2">
                    <span class="text-emerald-400">✓</span> Fast delivery
                  </div>
                  <div class="p-2.5 rounded-xl bg-white/5 border border-white/5 flex items-center gap-2">
                    <span class="text-emerald-400">✓</span> Clean code
                  </div>
                  <div class="p-2.5 rounded-xl bg-white/5 border border-white/5 flex items-center gap-2">
                    <span class="text-emerald-400">✓</span> SEO optimized
                  </div>
                  <div class="p-2.5 rounded-xl bg-white/5 border border-white/5 flex items-center gap-2">
                    <span class="text-emerald-400">✓</span> 100% Responsive
                  </div>
                </div>
              </div>

              <div class="pt-6 mt-6 border-t border-white/10">
                <a 
                  href="#contact" 
                  class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-gradient-to-r from-[#a476ff] to-[#8b5cf6] text-black font-bold text-xs hover:opacity-90 transition-all hover:scale-[1.01] shadow-lg shadow-[#a476ff]/20"
                >
                  <span>Start a Conversation</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          ) : (
            <div class="flex flex-col justify-between h-full">
              <div>
                <!-- Project Visual Header -->
                <div class="h-44 sm:h-52 bg-gradient-to-br from-[#191b2b] via-[#12131d] to-[#0c0d14] relative p-6 flex flex-col justify-between overflow-hidden border-b border-white/5">
                  <div class="flex items-center justify-between relative z-10">
                    <span class={`text-[11px] font-mono px-2.5 py-1 rounded-full font-semibold ${
                      project.badgeType === "flagship"
                        ? "bg-[#a476ff]/20 text-[#a476ff] border border-[#a476ff]/30"
                        : project.badgeType === "client"
                        ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30"
                        : "bg-purple-500/20 text-[#a476ff] border border-purple-500/30"
                    }`}>
                      {project.badge}
                    </span>
                    {project.subBadge && (
                      <span class="text-xs font-mono text-slate-400 bg-black/40 px-2.5 py-1 rounded-full border border-white/10">
                        {project.subBadge}
                      </span>
                    )}
                  </div>

                  <!-- Graphic Motif -->
                  <div class="my-auto text-center space-y-2 relative z-10">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-black/60 border border-white/10 shadow-2xl backdrop-blur-md">
                      <span class="text-[#a476ff] text-xs">◆</span>
                      <span class="text-xs font-mono text-slate-200 font-medium">{project.title}</span>
                    </div>
                  </div>

                  <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-[#a476ff]/10 rounded-full blur-3xl pointer-events-none group-hover:bg-[#a476ff]/20 transition-all duration-500"></div>
                </div>

                <!-- Project Body -->
                <div class="p-6 sm:p-7 space-y-4">
                  <div>
                    <h3 class="text-xl font-bold text-white group-hover:text-[#a476ff] transition-colors flex items-center justify-between">
                      <span>{project.title}</span>
                      <svg class="w-4 h-4 text-slate-500 group-hover:text-[#a476ff] group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-400 mt-2 leading-relaxed">
                      {project.description}
                    </p>
                  </div>

                  <!-- Tech Badges -->
                  <div class="flex flex-wrap gap-1.5 font-mono text-[11px]">
                    {project.tags.map((tag) => (
                      <span class="px-2.5 py-1 rounded-lg bg-white/5 border border-white/5 text-slate-300">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Action Links -->
              <div class="p-6 pt-0 flex items-center gap-3">
                {project.demoUrl && (
                  <a 
                    href={project.demoUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="flex-1 text-center py-2.5 px-4 rounded-xl bg-[#a476ff] text-black font-semibold text-xs hover:opacity-90 transition-all hover:scale-[1.01]"
                  >
                    {project.demoLabel || "Live Demo ↗"}
                  </a>
                )}
                {project.githubUrl && (
                  <a 
                    href={project.githubUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="py-2.5 px-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white font-medium text-xs transition-all"
                  >
                    GitHub
                  </a>
                )}
              </div>
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<script is:inline>
  // Project Filter Tabs logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-[#a476ff]', 'text-black', 'font-semibold');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('bg-[#a476ff]', 'text-black', 'font-semibold');
      btn.classList.remove('text-slate-400');

      const filter = btn.getAttribute('data-filter');
      projectItems.forEach(item => {
        const cat = item.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
