---

<section id="contact" class="max-w-5xl mx-auto px-4 py-12 relative z-10">
  <div class="bento-card rounded-3xl p-7 md:p-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <!-- Contact Info (Span 5) -->
      <div class="md:col-span-5 space-y-6 flex flex-col justify-between">
        <div class="space-y-3">
          <span class="text-xs font-mono text-[#a476ff] uppercase tracking-wider block">Get in Touch</span>
          <h2 class="text-3xl font-bold text-white tracking-tight">Let's build something exceptional.</h2>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Have a project, freelance inquiry, or technical question? Feel free to reach out directly.
          </p>
        </div>

        <div class="space-y-3 font-mono text-xs">
          <div class="p-3 rounded-2xl bg-white/5 border border-white/5 flex items-center gap-3">
            <span class="text-[#a476ff]">📍</span>
            <div>
              <span class="text-slate-400 block text-[10px]">Location</span>
              <span class="text-white font-medium">Muntinlupa, Philippines (UTC+8)</span>
            </div>
          </div>

          <div class="p-3 rounded-2xl bg-white/5 border border-white/5 flex items-center gap-3">
            <span class="text-[#a476ff]">✉️</span>
            <div>
              <span class="text-slate-400 block text-[10px]">Direct Email</span>
              <a href="mailto:panchojanjoseph15@gmail.com" class="text-white hover:text-[#a476ff] font-medium transition-colors">
                panchojanjoseph15@gmail.com
              </a>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex items-center gap-2 pt-2">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white transition-all hover:scale-105"
                title={social.label}
              >
                <fragment set:html={social.icon} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Formspree Interactive Form (Span 7) -->
      <div class="md:col-span-7">
        <form 
          id="contact-form" 
          action="https://formspree.io/f/mkjowklv" 
          method="POST" 
          class="space-y-4"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="text-xs font-mono text-slate-400">Your Name</label>
              <input 
                type="text" 
                name="name" 
                placeholder="e.g. Alex Smith" 
                required 
                class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-slate-600 focus:outline-none focus:border-[#a476ff] focus:ring-1 focus:ring-[#a476ff] text-xs transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-xs font-mono text-slate-400">Email Address</label>
              <input 
                type="email" 
                name="email" 
                placeholder="alex@domain.com" 
                required 
                class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-slate-600 focus:outline-none focus:border-[#a476ff] focus:ring-1 focus:ring-[#a476ff] text-xs transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-mono text-slate-400">Message & Scope</label>
            <textarea 
              name="message" 
              rows="4" 
              placeholder="Tell me about your goals, timeline, and what you're aiming to build..." 
              required 
              class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-slate-600 focus:outline-none focus:border-[#a476ff] focus:ring-1 focus:ring-[#a476ff] text-xs resize-none transition-all"
            ></textarea>
          </div>

          <button 
            type="submit" 
            id="submit-btn" 
            class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-[#a476ff] to-[#8b5cf6] text-black font-bold text-xs hover:opacity-95 transition-all hover:scale-[1.01] flex items-center justify-center gap-2 shadow-lg shadow-[#a476ff]/20 cursor-pointer"
          >
            <span>Send Message</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>
        </form>

        <div id="form-success" class="hidden p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-center space-y-2">
          <span class="text-2xl">✨</span>
          <p class="text-sm font-semibold text-white">Message Dispatched!</p>
          <p class="text-xs text-slate-400">Thank you for getting in touch. I will respond to your inquiry shortly.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById("contact-form");
  const formSuccess = document.getElementById("form-success");
  const submitBtn = document.getElementById("submit-btn");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = "<span>Sending message...</span>";
      }

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          form.reset();
          form.style.display = "none";
          if (formSuccess) formSuccess.classList.remove("hidden");
        } else {
          alert("There was a problem sending your message. Please reach out via email directly.");
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = "<span>Send Message</span>";
          }
        }
      } catch (err) {
        console.error("Form submission error:", err);
        alert("There was a problem sending your message. Please reach out via email directly.");
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = "<span>Send Message</span>";
        }
      }
    });
  }
</script>
